{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ROOMINK_API_BASE_URL": "https://api-staging.roomink.net/api"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ROOMINK_API_BASE_URL": "https://api-staging.roomink.net/api"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production-internal": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ROOMINK_API_BASE_URL": "https://api.roomink.net/api"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "testflight": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_ROOMINK_API_BASE_URL": "https://api-staging.roomink.net/api"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "testflight": {}
  }
}
