# Isolated backend staging environment. Never reuse the production database.
DJANGO_ENV=staging
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-staging-only-secret
DJANGO_ALLOWED_HOSTS=api-staging.roomink.net
DJANGO_CORS_ALLOWED_ORIGINS=https://staging.roomink.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.roomink.net
FRONTEND_URL=https://staging.roomink.net
RESERVATION_LINK_BASE_URL=https://staging.roomink.net
SMS_DUMMY_MODE=1
PUBLIC_BOOKING_ENABLED=0
TWILIO_WEBHOOK_PUBLIC_BASE_URL=https://api-staging.roomink.net
TWILIO_WEBHOOK_ALLOW_UNSIGNED=0
# BYOC is intentionally not connected to staging.
